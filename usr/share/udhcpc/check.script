#!/bin/sh

case "$1" in
        deconfig)
        ;;
        renew)
                echo "YES" > /tmp/.dhcp-server-test.txt
                exit 0
        ;;
        bound)
                echo "YES" > /tmp/.dhcp-server-test.txt
                exit 0
        ;;
esac

echo "NO" > /tmp/.dhcp-server-test.txt

exit 0
